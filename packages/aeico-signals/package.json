{
  "name": "aeico-signals",
  "version": "0.1.0",
  "description": "TC39 Signals proposal polyfill for JavaScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c rollup.config.js && tsc --declaration --emitDeclarationOnly --outDir dist/types -p tsconfig.json",
    "dev": "rollup -c rollup.config.js --watch",
    "type-check": "tsc --noEmit",
    "test": "web-test-runner --config web-test-runner.config.mjs",
    "test:watch": "web-test-runner --config web-test-runner.config.mjs --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signals",
    "tc39",
    "reactive",
    "reactivity",
    "aeico"
  ],
  "author": "Eowl",
  "license": "ISC",
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "typescript": "^5.7.3"
  }
}
