{
  "name": "aeico",
  "version": "0.1.6",
  "description": "Lightweight Web Components framework — reactive elements, DOM rendering and i18n",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c rollup.config.js && tsc --declaration --emitDeclarationOnly --outDir dist/types -p tsconfig.json",
    "dev": "rollup -c rollup.config.js --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "reactive",
    "framework",
    "aeico"
  ],
  "author": "Eowl",
  "license": "ISC",
  "dependencies": {
    "aeico-element": "^0.1.5",
    "aeico-view": "^0.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-replace": "^6.0.3",
    "typescript": "^5.7.3"
  }
}
