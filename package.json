{
  "name": "aeico",
  "version": "0.1.0",
  "description": "Lightweight Web Components library for building form fields and UI elements",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "web-components",
    "ui-components",
    "form-fields",
    "custom-elements"
  ],
  "homepage": "https://github.com/eowl/aeico#readme",
  "bugs": {
    "url": "https://github.com/eowl/aeico/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eowl/aeico.git"
  },
  "author": "eowl",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
