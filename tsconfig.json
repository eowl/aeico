{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Decorators"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true
  },
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "./packages/aeico-view" },
    { "path": "./packages/aeico-core" },
    { "path": "./packages/aeico-localize" },
    { "path": "./packages/aeico" }
  ]
}
