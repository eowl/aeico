{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./.tsbuildinfo",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["mocha"]
  },
  "include": ["src/**/*", "test/**/*"]
}
