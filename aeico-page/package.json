{
  "name": "aeico-page",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown-first static site generator",
  "bin": {
    "aeico-page": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "theme"
  ],
  "scripts": {
    "compile": "tsc && vite build --config vite.components.config.ts",
    "prepublishOnly": "npm run compile",
    "build": "npm run compile && node ./dist/cli.js build",
    "dev": "npm run compile && node ./dist/cli.js dev",
    "preview": "npm run compile && node ./dist/cli.js preview",
    "init": "npm run compile && node ./dist/cli.js init",
    "example:build": "npm run compile && node ./dist/cli.js build --site ./examples/basic-site",
    "example:dev": "npm run compile && node ./dist/cli.js dev --site ./examples/basic-site",
    "example:preview": "npm run compile && node ./dist/cli.js preview --site ./examples/basic-site"
  },
  "dependencies": {
    "aeico": "file:../"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^5.8.3",
    "vite": "^6.0.0"
  }
}
