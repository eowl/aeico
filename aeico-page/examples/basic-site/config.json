{
  "site": {
    "title": "aeico-page Example",
    "description": "A site generated by aeico-page core + cli",
    "base": "/",
    "origin": "http://localhost:4173"
  },
  "content": {
    "rootDir": "content"
  },
  "layout": {
    "rootDir": "layout",
    "defaultLayout": "home"
  },
  "routing": {
    "trailingSlash": "always",
    "cleanIndex": true,
    "slugify": "lower"
  },
  "i18n": {
    "enabled": true,
    "mode": "same-path",
    "defaultLocale": "zh-CN",
    "locales": ["zh-CN", "en-US"]
  },
  "theme": {
    "mode": "auto",
    "switchable": true
  },
  "build": {
    "outDir": "dist"
  }
}
